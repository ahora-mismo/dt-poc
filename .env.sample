# dt-agent configuration
#
# Every variable below is required (D-65): the app has no built-in defaults
# and fails at startup naming every missing/invalid variable (D-29). The
# values here are recommended starting points only; the app never assumes
# them (D-37). Loaded by tooling (uv/IDE/Docker), never by the app itself
# (D-15, D-53). Keep this file in sync with `.env` by hand.

# ---------------------------------------------------------------------------
# Google (D-18)
# ---------------------------------------------------------------------------

# OAuth client ID for the dedicated Gmail/Calendar account (Google Cloud
# Console, OAuth 2.0 Client credentials).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OAuth client secret matching GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth refresh token for the dedicated account, written here by the setup
# wizard terraform/print_env.sh (with GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET).
# The consent screen stays in Testing, so it expires after 7 days: run the
# wizard again for a new one. The mailbox address itself is never configured;
# it is read from users.getProfile at startup.
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# ---------------------------------------------------------------------------
# LLM (D-36)
# ---------------------------------------------------------------------------

# Which LLM provider the whole app uses (one global choice, Haiku-tier
# models only). Options: gemini | anthropic | azure
LLM_PROVIDER=anthropic

# API key for Google Gemini. Required only when LLM_PROVIDER=gemini.
GEMINI_API_KEY=your-gemini-api-key

# API key for Anthropic Claude. Required only when LLM_PROVIDER=anthropic.
# Use a workspace-scoped key (created inside a workspace in the Anthropic
# Console): a key without a workspace is rejected with HTTP 400.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Model name, used for gemini and anthropic only (azure uses the deployment
# name instead). Examples: gemini="gemini-2.5-flash-lite" or
# "gemini-2.0-flash-lite"; anthropic="claude-haiku-4-5-20251001". Required
# only when LLM_PROVIDER is gemini or anthropic.
LLM_MODEL=claude-haiku-4-5-20251001

# Azure OpenAI resource endpoint. Required only when LLM_PROVIDER=azure.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Azure OpenAI API key. Required only when LLM_PROVIDER=azure.
AZURE_OPENAI_API_KEY=your-azure-openai-api-key

# Azure OpenAI API version, e.g. "2024-10-21". Required only when
# LLM_PROVIDER=azure.
AZURE_OPENAI_API_VERSION=2024-10-21

# Name of the Azure OpenAI deployment behind a Haiku-tier model (e.g. a
# gpt-4o-mini deployment). This selects the model for azure; LLM_MODEL is
# not used. Required only when LLM_PROVIDER=azure.
AZURE_OPENAI_DEPLOYMENT=your-azure-openai-deployment

# ---------------------------------------------------------------------------
# Approval / sending (D-10, D-23, D-33, D-38, D-46)
# ---------------------------------------------------------------------------

# Display name on every outgoing message (approval emails, notifications,
# replies) and used to sign replies. Set it to the manager's own name when
# MANAGER_EMAIL is empty, or to an assistant-style name (e.g. "Anna's
# Assistant") when MANAGER_EMAIL is external. The sending address is always
# the Gmail account itself.
AGENT_SENDER_NAME="Alex's Assistant"

# Approver address. May be empty: empty (or equal to the mailbox address)
# means approval/notification emails go to the monitored mailbox itself and
# the manager replies from it. Set to an external address to route approvals
# there instead.
MANAGER_EMAIL=

# HS256 signing key (PyJWT) for approval tokens embedded in emails. Every
# component, including the MCP server, uses the same key. Generate with:
# python -c "import secrets;print(secrets.token_hex(32))"
APPROVAL_SIGNING_KEY=replace-with-a-random-64-character-hex-string

# How many business days an approval token stays valid before it expires.
APPROVAL_EXPIRY_BUSINESS_DAYS=3

# Whether a sales-outreach decline reply also needs manager approval before
# sending. Options: true | false
SALES_DECLINE_REQUIRES_APPROVAL=false

# ---------------------------------------------------------------------------
# Sender rules (D-42, D-61)
# ---------------------------------------------------------------------------

# Comma-separated list of internal domains (senders on these domains, once
# authenticated, are treated as internal). May be empty: empty means no
# internal senders.
INTERNAL_DOMAINS=

# Comma-separated list of exact sender addresses trusted as a spam-detection
# hint (case-insensitive). May be empty: empty means no allowlisted senders.
SPAM_ALLOWLIST_SENDERS=

# Comma-separated list of trusted sender domains (also covers subdomains) as
# a spam-detection hint (case-insensitive). May be empty: empty means no
# allowlisted domains.
SPAM_ALLOWLIST_DOMAINS=

# ---------------------------------------------------------------------------
# Calendar (D-1, ADR-4)
# ---------------------------------------------------------------------------

# IANA timezone used for business hours, scheduling and date-expression
# resolution, e.g. "Europe/Bucharest".
DEFAULT_TIMEZONE=Europe/Bucharest

# Business day start hour (0-24, local to DEFAULT_TIMEZONE). Must be smaller
# than BUSINESS_HOURS_END.
BUSINESS_HOURS_START=9

# Business day end hour (0-24, local to DEFAULT_TIMEZONE; 24 means midnight).
# Must be greater than BUSINESS_HOURS_START.
BUSINESS_HOURS_END=18

# Default meeting length in minutes, used when the sender doesn't state one.
DEFAULT_MEETING_MINUTES=30

# How many business days ahead the agent looks for open slots when
# proposing meeting options.
SCHEDULING_HORIZON_BUSINESS_DAYS=5

# Minimum lead time in minutes before a proposed slot can start.
MEETING_MIN_LEAD_MINUTES=25

# Maximum number of slot options offered in one approval email.
MEETING_MAX_OPTIONS=3

# ---------------------------------------------------------------------------
# Runtime (D-19, D-20, D-30, D-43, D-56)
# ---------------------------------------------------------------------------

# How often (in seconds) the poller checks Gmail history for new messages.
# Minimum allowed value: 5.
POLL_INTERVAL_SECONDS=15

# Delay in milliseconds a worker waits between sending consecutive outbound
# actions (rate-limiting courtesy toward Gmail).
ACTION_DELAY_MS=1000

# Number of concurrent workers draining the processing queue.
WORKER_COUNT=2

# Maximum attempts for a queued email before giving up and flagging it for
# review.
MAX_ATTEMPTS=3

# Maximum number of characters of email text sent to the LLM; longer text is
# truncated (and the truncation logged).
LLM_MAX_INPUT_CHARS=20000

# ---------------------------------------------------------------------------
# State (D-6, D-7, D-28)
# ---------------------------------------------------------------------------

# Path to the SQLite database file, on a durable volume.
DB_PATH=data/agent.db

# How many of the most recent INBOX messages are looked at during the
# startup backfill.
STARTUP_BACKFILL_MESSAGES=20

# How many days of processed-message history are retained before purging.
RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Logging (D-58)
# ---------------------------------------------------------------------------

# Minimum log level emitted by the unified logger. Options: DEBUG | DEV |
# INFO | WARNING | ERROR. DEV (between DEBUG and INFO) holds the LLM request
# lines (per-call usage and the SDKs' HTTP requests), hidden at INFO.
MIN_LOG_LEVEL=INFO

# Whether stdout log lines are colour-highlighted like `jq`. Options: auto
# (colour only when stdout is a terminal) | always | never
LOG_COLOR=auto

# ---------------------------------------------------------------------------
# MCP (D-59)
# ---------------------------------------------------------------------------

# Whether the app also serves an MCP server (dry-run tools for testing the
# agent's decisions) on MCP_PORT, in the same process. Options: true | false
ENABLE_MCP=false

# TCP port for the MCP server's streamable HTTP transport, published to
# 127.0.0.1 only. Required only when ENABLE_MCP=true.
MCP_PORT=8765

# Address the MCP server's streamable HTTP transport listens on. Required
# only when ENABLE_MCP=true (D-59, D-65). 127.0.0.1 for local runs, so it's
# never reachable from outside this machine; docker-compose.yml overrides
# this to 0.0.0.0 inside the container (needed for Docker to publish the
# port), while still only publishing it to the host's 127.0.0.1.
MCP_HOST=127.0.0.1
